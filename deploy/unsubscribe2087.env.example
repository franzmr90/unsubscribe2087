# Copy to /etc/unsubscribe2087.env, edit, then: chmod 600 /etc/unsubscribe2087.env
# It holds the SMTP password, so it should not be world-readable.

PORT=8087

# Set this to the real https URL. It builds the links in emails, and an https value is
# what turns on Secure cookies. Getting it wrong breaks password recovery quietly.
PUBLIC_ORIGIN=https://yourdomain.com

# Only with a proxy in front that sets X-Forwarded-For — Caddy does. Without a proxy,
# leave it off, or clients forge their own rate-limit identity.
TRUST_PROXY=1

# Outside the checkout, so redeploying cannot delete everybody's characters.
DATA_DIR=/var/lib/unsubscribe2087

# Ceilings. One over either is refused with a message rather than degrading.
MAX_PLAYERS=400
MAX_GAMES=200

# Without an SMTP host, mail is written to $DATA_DIR/outbox and logged instead. The
# server still runs; password recovery just cannot reach anybody.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
MAIL_FROM=Unsubscribe 2087 <no-reply@yourdomain.com>

# Registration. 1 means a new account needs an invite code or an ALLOWLIST hit.
# ALLOWLIST is comma-separated emails or exact account names. INVITE_CODES is an
# optional comma-separated set of static codes (unlimited). Mint more with
# `node server/admin.js invite mint` — see HOSTING.md.
INVITE_REQUIRED=1
ALLOWLIST=
INVITE_CODES=

# Bearer token for `node server/admin.js` online/kick/broadcast/reset. setup.sh
# fills this in when it writes the file. At least 16 characters, or the routes
# stay dark. Generate one with: openssl rand -hex 24
ADMIN_TOKEN=

# Browsers must send this site's origin on the WebSocket. Leave on for a real box.
# Local node tests do not set it.
WS_REQUIRE_ORIGIN=1

# Optional. Defaults to a hash of the built page. Set it if you want deploys to
# force a reload even when the fragment did not change.
# BUILD_ID=

# Voice. Empty means public STUN only, which fails for some strict NATs.
# TURN_URLS is a comma-separated list. A relay on this same box is free apart
# from bandwidth; a hosted relay is a few euros a month. See HOSTING.md.
# TURN=1 on deploy/setup.sh installs coturn and fills these three when TURN_URLS
# is still empty. It does not rotate a password that is already set.
# TURN_URLS=turn:yourdomain.com:3478
# TURN_USER=
# TURN_PASS=

# Executable that receives each nightly archive path and copies it off the box.
# BACKUP_HOOK=/usr/local/bin/unsubscribe2087-offbox

# 1 injects window.__DEBUG so the in-game test hooks exist on the public host.
# Leave unset. Testers do not need them.
# DEBUG_HOOKS=

# Bug intake. Leave GITHUB_TOKEN empty and reports stay files in $DATA_DIR/bugs,
# which is how the server behaves without this feature. A fine-grained token needs
# Issues read/write on this one repository and nothing else. See HOSTING.md.
# GITHUB_TOKEN=
# BUG_REPO=franzmr90/unsubscribe2087
# The webhook URL and key come from a Grok Bot routine's webhook panel.
# BUG_WEBHOOK_URL=
# BUG_WEBHOOK_KEY=
# Header that carries the key. Authorization is sent as "Bearer <key>". Any other
# name is sent as the raw key.
# BUG_WEBHOOK_KEY_HEADER=Authorization
